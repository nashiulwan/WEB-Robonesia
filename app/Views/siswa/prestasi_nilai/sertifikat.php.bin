<!-- Jquery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
  // UTAMA: Buka modal atau tab baru berdasarkan ukuran layar
  function openModal(dataUrl, fileType) {
    const isMobile = (window.innerWidth <= 768); // batas layar mobile

    // Jika PDF
    if (fileType === "application/pdf") {
      if (isMobile) {
        // Render PDF di modal dengan PDF.js
        showPdfModal(dataUrl);
      } else {
        // Desktop -> Buka di tab baru
        window.open(dataUrl, "_blank");
      }
    }
    // Jika gambar
    else if (fileType.startsWith("image/")) {
      showImageModal(dataUrl);
    }
    // File lain
    else {
      alert("Preview tidak tersedia untuk file ini. Silakan unduh langsung.");
    }
  }

  // =========== MODAL UNTUK GAMBAR ==============
  function showImageModal(imgUrl) {
    const modal = document.getElementById("fileModal");
    const modalContent = document.getElementById("modalContent");
    modalContent.innerHTML = "";

    // Buat elemen gambar
    const img = document.createElement("img");
    img.src = imgUrl;
    img.style.height = "100%";
    img.style.width = "auto";
    img.style.display = "block";
    img.style.margin = "auto";
    modalContent.appendChild(img);

    // Tombol unduh
    const downloadButton = document.createElement("a");
    downloadButton.href = imgUrl;
    downloadButton.download = "image_download";
    downloadButton.textContent = "Download Gambar";
    downloadButton.className = "btn-download btn btn-primary download-btn";
    modalContent.appendChild(downloadButton);

    modal.style.display = "block";
  }

  // =========== MODAL UNTUK PDF (MOBILE) MENGGUNAKAN PDF.js ==============
  function showPdfModal(pdfUrl) {
    const modal = document.getElementById("fileModal");
    const modalContent = document.getElementById("modalContent");
    modalContent.innerHTML = `
      <div id="pdfViewer" style="width: 100%; height: 100%; overflow: auto;"></div>
    `;

    // Tombol unduh PDF
    const downloadButton = document.createElement("a");
    downloadButton.href = pdfUrl;
    downloadButton.download = "sertifikat.pdf";
    downloadButton.textContent = "Download PDF";
    downloadButton.className = "btn-download btn btn-primary download-btn";
    modalContent.appendChild(downloadButton);

    // Render PDF dengan PDF.js
    renderPDF(pdfUrl);

    modal.style.display = "block";
  }

  // =========== FUNGSI RENDER PDF.js ============
  async function renderPDF(pdfUrl) {
    // Akses library PDF.js
    const pdfjsLib = window['pdfjs-dist/build/pdf'];

    // Set lokasi worker PDF.js (wajib)
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.14.305/pdf.worker.min.js";

    try {
      // Memuat dokumen PDF
      const pdf = await pdfjsLib.getDocument(pdfUrl).promise;
      const viewer = document.getElementById("pdfViewer");
      viewer.innerHTML = ""; // Bersihkan isi

      // Loop semua halaman
      for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
        const page = await pdf.getPage(pageNum);
        const scale = 1.0; // Zoom 100%
        const viewport = page.getViewport({
          scale
        });

        // Buat canvas untuk render
        const canvas = document.createElement("canvas");
        const context = canvas.getContext("2d");
        canvas.height = viewport.height;
        canvas.width = viewport.width;

        // Render halaman PDF ke canvas
        await page.render({
          canvasContext: context,
          viewport
        }).promise;

        // Tambahkan canvas ke viewer
        viewer.appendChild(canvas);
      }
    } catch (err) {
      console.error("Error rendering PDF:", err);
      const viewer = document.getElementById("pdfViewer");
      viewer.innerHTML = "<p style='color:red;'>Gagal memuat PDF. Silakan unduh saja.</p>";
    }
  }

  // =========== TUTUP MODAL =============
  function closeModal() {
    document.getElementById("fileModal").style.display = "none";
  }

  document.getElementById("closeModal").addEventListener("click", closeModal);
  window.addEventListener("click", function(event) {
    const modal = document.getElementById("fileModal");
    if (event.target === modal) {
      closeModal();
    }
  });
</script>
<?= $this->endSection() ?>