# Mencegah akses langsung ke semua file di folder kecuali file PDF yang akan ditampilkan di browser
<FilesMatch "\.pdf$">
    Require all granted
    Header set Content-Disposition inline
</FilesMatch>

# Mencegah akses langsung ke semua file lain
<IfModule authz_core_module>
    Require all denied
</IfModule>
<IfModule !authz_core_module>
    Deny from all
</IfModule>
